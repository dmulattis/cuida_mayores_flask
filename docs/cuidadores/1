<!--Ficha de cuidador en detalle para la aplicación web de administración de cuidadores. La plantilla extiende de "base.html" y define el contenido específico para la página de detalle, mostrando información completa del cuidador seleccionado, incluyendo datos de contacto, especialidad, experiencia, tarifa diaria, disponibilidad, estado de validación y descripción. También proporciona enlaces para editar o eliminar el perfil del cuidador.-->
<!-- Plantilla base para la aplicación web de administración de cuidadores. -->
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>María González | Cuida a tus Mayores</title>

    <!-- Bootstrap 5 (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- CSS propio: se carga después de Bootstrap para poder sobrescribir estilos puntuales -->
    <link rel="stylesheet" href="../static/css/estilos.css">
</head>
<body>

<header class="encabezado">
    <nav class="navbar navbar-expand-md">
        <div class="container">
            <a class="navbar-brand marca" href="../index.html">Cuida a tus Mayores</a>

            <!-- Botón hamburguesa: visible solo en pantallas chicas -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navPrincipal" aria-controls="navPrincipal"
                    aria-expanded="false" aria-label="Abrir navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navPrincipal">
                <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
                    <li class="nav-item">
                        <a class="nav-link" href="../index.html">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="index.html">Cuidadores</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn boton boton-claro" href="nuevo">Registrar</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container contenido py-4">
    
        
    

    <div class="row">
        <div class="col-12">
            
<div class="titulo-con-accion d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <a class="volver d-inline-block mb-2" href="index.html">← Volver al listado</a>
        <h1 class="h2 mb-1">María González</h1>
        <p class="mb-0">Cuidado Adulto Mayor · Concepción</p>
    </div>
    <div class="acciones d-flex gap-2">
        <a class="btn boton" href="1/editar">Editar</a>
        <a class="btn boton boton-peligro" href="1/eliminar">Eliminar</a>
    </div>
</div>

<section class="row g-4">
    <article class="col-12 col-lg-6">
        <div class="panel h-100 p-4">
            <h2 class="h4">Información del perfil</h2>
            <dl class="row mb-0">
                <dt class="col-5 col-sm-4">Correo</dt><dd class="col-7 col-sm-8">maria@example.com</dd>
                <dt class="col-5 col-sm-4">Teléfono</dt><dd class="col-7 col-sm-8">+56912345678</dd>
                <dt class="col-5 col-sm-4">Comuna</dt><dd class="col-7 col-sm-8">Concepción</dd>
                <dt class="col-5 col-sm-4">Especialidad</dt><dd class="col-7 col-sm-8">Cuidado Adulto Mayor</dd>
                <dt class="col-5 col-sm-4">Experiencia</dt><dd class="col-7 col-sm-8">5 año(s)</dd>
                <dt class="col-5 col-sm-4">Tarifa diaria</dt><dd class="col-7 col-sm-8">$35.000</dd>
                <dt class="col-5 col-sm-4">Disponibilidad</dt><dd class="col-7 col-sm-8">Disponible</dd>
                <dt class="col-5 col-sm-4">Validación</dt>
                <dd class="col-7 col-sm-8"><span class="estado estado-aprobado">Aprobado</span></dd>
            </dl>
        </div>
    </article>

    <article class="col-12 col-lg-6">
        <div class="panel h-100 p-4">
            <h2 class="h4">Descripción</h2>
            <p class="texto-largo">Especialista en atención y compañía para adultos mayores.</p>
            <p class="dato-secundario mb-0">Registro creado el 20-08-2026.</p>
        </div>
    </article>
</section>

        </div>
    </div>
</main>

<footer class="pie">
    <div class="container">Prototipo académico de gestión de cuidadores.</div>
</footer>

<!-- Bootstrap 5 JS Bundle (incluye Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
