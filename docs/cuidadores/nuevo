<!-- Plantilla base para la aplicación web de administración de cuidadores. -->
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registrar nuevo cuidador | Cuida a tus Mayores</title>

    <!-- Bootstrap 5 (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- CSS propio: se carga después de Bootstrap para poder sobrescribir estilos puntuales -->
    <link rel="stylesheet" href="../static/css/estilos.css">
</head>
<body>

<header class="encabezado">
    <nav class="navbar navbar-expand-md">
        <div class="container">
            <a class="navbar-brand marca" href="../index.html">Cuida a tus Mayores</a>

            <!-- Botón hamburguesa: visible solo en pantallas chicas -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navPrincipal" aria-controls="navPrincipal"
                    aria-expanded="false" aria-label="Abrir navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navPrincipal">
                <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
                    <li class="nav-item">
                        <a class="nav-link" href="../index.html">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="index.html">Cuidadores</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn boton boton-claro" href="nuevo">Registrar</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container contenido py-4">
    
        
    

    <div class="row">
        <div class="col-12">
            
<a class="volver d-inline-block mb-2" href="index.html">← Volver al listado</a>
<h1 class="h2">Registrar nuevo cuidador</h1>
<p>Completa los antecedentes principales del perfil.</p>

<form class="formulario panel p-4" method="post" action="nuevo" novalidate>
    <div class="row g-3">
        <!-- Nombre completo -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Nombre completo *
                <input class="form-control" name="nombre" required maxlength="50" value="">
            </label>
        </div>

        <!-- Correo electrónico -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Correo electrónico *
                <input class="form-control" type="email" name="correo" required maxlength="120" value="">
            </label>
        </div>

        <!-- Teléfono -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Teléfono *
                <input class="form-control" name="telefono" required maxlength="30" value="">
            </label>
        </div>

        <!-- Comuna -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Comuna *
                
                <select class="form-select" name="comuna_id" id="comuna_id" required>
                    <option value="">Seleccionar comuna</option>
                    
                        <option value="1" >Concepción</option>
                    
                        <option value="3" >San Pedro de la Paz</option>
                    
                        <option value="2" >Talcahuano</option>
                    
                    <option value="otra" >Otra comuna</option>
                </select>
            </label>
        </div>

        <!-- Nueva comuna -->
        <div class="col-12 col-md-6" id="grupo-comuna-nueva" style="display: none;">
            <label class="form-label w-100">Especificar nueva comuna *
                <input class="form-control" name="comuna_nueva" id="comuna_nueva" maxlength="80" value="" placeholder="Ejemplo: Santiago">
            </label>
        </div>

        <!-- Especialidad / Profesión -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Especialidad o profesión *
                
                <select class="form-select" name="especialidad_id" id="especialidad_id" required>
                    <option value="">Seleccionar especialidad</option>
                    
                        <option value="1" >Cuidado Adulto Mayor</option>
                    
                        <option value="2" >Enfermería Básica</option>
                    
                        <option value="3" >Kinesiología</option>
                    
                    <option value="otra" >Otra especialidad / profesión</option>
                </select>
            </label>
        </div>

        <!-- Nueva especialidad -->
        <div class="col-12 col-md-6" id="grupo-especialidad-nueva" style="display: none;">
            <label class="form-label w-100">Especificar nueva especialidad o profesión *
                <input class="form-control" name="especialidad_nueva" id="especialidad_nueva" maxlength="100" value="" placeholder="Ejemplo: Terapeuta Ocupacional">
            </label>
        </div>

        <!-- Años de experiencia -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Años de experiencia *
                <input class="form-control" type="number" name="experiencia_anios" min="0" max="60" required value="0">
            </label>
        </div>

        <!-- Tarifa diaria -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Tarifa diaria (CLP) *
                <input class="form-control" type="number" name="tarifa_diaria" min="1" step="1000" required value="">
            </label>
        </div>

        <!-- Estado de validación -->
        <div class="col-12 col-md-6">
            <label class="form-label w-100">Estado de validación *
                
                <select class="form-select" name="estado_validacion" required>
                    <option value="Pendiente" selected>Pendiente</option>
                    <option value="Aprobado" >Aprobado</option>
                    <option value="Rechazado" >Rechazado</option>
                </select>
            </label>
        </div>
    </div>

    <!-- Descripción -->
    <div class="mt-3">
        <label class="form-label w-100">Descripción
            <textarea class="form-control" name="descripcion" rows="5" maxlength="1000"></textarea>
        </label>
    </div>

    <!-- Disponibilidad -->
    
    <div class="form-check mt-3">
        <input class="form-check-input" type="checkbox" name="disponible" id="disponible" checked>
        <label class="form-check-label check" for="disponible">Disponible para recibir solicitudes</label>
    </div>

    <!-- Acciones -->
    <div class="acciones d-flex flex-column flex-sm-row gap-2 mt-4">
        <button class="btn boton" type="submit">Guardar</button>
        <a class="btn boton boton-secundario" href="index.html">Cancelar</a>
    </div>
</form>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const selectComuna = document.getElementById("comuna_id");
    const grupoComunaNueva = document.getElementById("grupo-comuna-nueva");
    const inputComunaNueva = document.getElementById("comuna_nueva");

    const selectEspecialidad = document.getElementById("especialidad_id");
    const grupoEspecialidadNueva = document.getElementById("grupo-especialidad-nueva");
    const inputEspecialidadNueva = document.getElementById("especialidad_nueva");

    function actualizarCampoNuevo(select, grupo, input) {
        if (select.value === "otra") {
            grupo.style.display = "block";
            input.required = true;
        } else {
            grupo.style.display = "none";
            input.required = false;
            input.value = "";
        }
    }

    actualizarCampoNuevo(selectComuna, grupoComunaNueva, inputComunaNueva);
    actualizarCampoNuevo(selectEspecialidad, grupoEspecialidadNueva, inputEspecialidadNueva);

    selectComuna.addEventListener("change", function () {
        actualizarCampoNuevo(selectComuna, grupoComunaNueva, inputComunaNueva);
    });

    selectEspecialidad.addEventListener("change", function () {
        actualizarCampoNuevo(selectEspecialidad, grupoEspecialidadNueva, inputEspecialidadNueva);
    });
});
</script>

        </div>
    </div>
</main>

<footer class="pie">
    <div class="container">Prototipo académico de gestión de cuidadores.</div>
</footer>

<!-- Bootstrap 5 JS Bundle (incluye Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>